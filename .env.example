# 复制这个文件为 .env，然后填入你自己的 key
# 注意：.env 已被 .gitignore 排除，不会上传到 GitHub

# ---------- 大模型（阿里云百炼，OpenAI 兼容模式）----------
# 获取地址：https://bailian.console.aliyun.com/
OPENAI_API_KEY=sk-你的百炼密钥

# ---------- 高德开放平台（可选，不填则用本地模拟数据）----------
# 必须是「Web服务」类型的 key，不是「Web端(JS API)」的 key
# 获取地址：https://console.amap.com/dev/key/app
AMAP_KEY=

# 下面两个只给界面里的地图用（JS API），不填则地图区域显示占位提示
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
